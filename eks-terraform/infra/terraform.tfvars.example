aws_region          = "us-east-1"
cluster_name        = "eks-lab"
kubernetes_version  = "1.35"
node_instance_type  = "t3.medium"
# Replace both placeholders before running plan.
admin_cidr          = "REPLACE_WITH_YOUR_PUBLIC_IPV4/32"
admin_principal_arn = "arn:aws:iam::123456789012:role/REPLACE_WITH_YOUR_ADMIN_ROLE"
